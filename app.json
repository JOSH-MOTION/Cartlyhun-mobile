{
  "expo": {
    "name": "Cartlyhubgh",
    "slug": "cartlyhubgh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cartlyhub-icon-1024.png",
    "scheme": "cartlyhubgh",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#fa8929",
    "description": "Cartlyhubgh — Ghana's premier mobile marketplace. Buy and sell fashion, electronics, vehicles, food, services and more.",
    "privacy": "public",
    "splash": {
      "image": "./assets/cartlyhub-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#fa8929"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cartlyhubgh.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Cartlyhubgh needs camera access to take photos of products you want to list.",
        "NSPhotoLibraryUsageDescription": "Cartlyhubgh needs photo library access to upload product images.",
        "NSLocationWhenInUseUsageDescription": "Cartlyhubgh uses your location to show nearby listings.",
        "NSUserNotificationUsageDescription": "Cartlyhubgh sends notifications about your orders and messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/cartlyhub-adaptive-icon.png",
        "backgroundColor": "#fa8929"
      },
      "icon": "./assets/cartlyhub-icon-1024.png",
      "package": "com.cartlyhub.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cartlyhubgh.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.875954381628-urvjvsornjv4tv6t7vldvb1j6uslo4c8"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/cartlyhub-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/cartlyhub-icon-1024.png",
          "color": "#fa8929",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cartlyhubgh needs access to your photos to upload product images.",
          "cameraPermission": "Cartlyhubgh needs camera access to take product photos."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://cartlyhubgh.com/privacy",
      "router": {},
      "eas": {
        "projectId": "81e3e752-7f46-4497-b0ba-1910c52d19c2"
      }
    }
  }
}
